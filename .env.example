# Copy to .env, fill in your key locally, then restart the server.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_SEARCH_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PORT=4173
# Leave blank locally. Hosting: exact HTTPS origin, with no path.
# Render automatically uses its RENDER_EXTERNAL_URL when this is blank.
PUBLIC_ORIGIN=
# Hosting: absolute persistent-disk directory. Local default: .local
DATA_DIR=
